{
  "name": "einkaufsliste-sites-worker",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "db:generate": "drizzle-kit generate",
    "check": "node server/node_modules/typescript/lib/tsc.js --allowJs --checkJs --noEmit --strict --target ES2022 --lib DOM,DOM.Iterable,ES2022 app.js",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "drizzle-orm": "0.45.2",
    "drizzle-kit": "0.31.10",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    }
  }
}
